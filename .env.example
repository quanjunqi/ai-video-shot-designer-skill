PEARAPI_TOKEN=replace_with_your_token
PEARAPI_BASE_URL=https://api.pearapi.ai/v1
# 文生图：只用于建立项目的规范资产（角色、场景、道具的 canonical 版本）
PEARAPI_TEXT_MODEL=gpt-image-2
# 参考图/多参考编辑：所有需要继承已有资产的派生图必须使用此模型
PEARAPI_REFERENCE_MODEL=nano-banana-2-2k
# 项目风格锁，必须与 project_ledger.json 的 style_lock 一致
PEARAPI_STYLE=STYLE-01

# v3 图片生成统一接口。可指向支持 /images/generations 的供应商。
IMAGE_API_BASE_URL=https://example.com/v1
IMAGE_API_TOKEN=replace_with_your_token
IMAGE_API_TEXT_MODEL=replace_with_text_to_image_model
IMAGE_API_REFERENCE_MODEL=replace_with_reference_edit_model

# AutoDL Art MiniMax H3 全能参考视频工作流。真实 token 只写入本地 .env。
AUTODL_ART_TOKEN=replace_with_your_token
AUTODL_ART_BASE_URL=https://autodl.art/api/v1/comfyui/comfyui_workflow
AUTODL_ART_MINIMAX_WORKFLOW=minimax_h3_zm_u24
